[worldserver]

#####################################################
# Dual Spec Command Module
#####################################################
#
#    DualSpec.Enable
#        Description: Enable or disable the .dualspec player command,
#                     which unlocks Dual Talent Specialization for the
#                     calling character.
#        Default:     1 - Enabled
#                     0 - Disabled
#

DualSpec.Enable = 1

#
#    DualSpec.Cost
#        Description: Price of Dual Talent Specialization, in gold.
#                     When above 0, the player types .dualspec to see the
#                     price and .dualspec confirm to pay and unlock.
#                     0 makes it free and unlocks on the first .dualspec.
#        Default:     1000 - Blizzard's price
#

DualSpec.Cost = 1000

#
#    DualSpec.MinLevel
#        Description: Minimum character level for .dualspec and for
#                     DualSpec.AutoUnlock. Independent of the worldserver
#                     MinDualSpecLevel setting, which only applies to the
#                     class trainer option.
#        Default:     10
#

DualSpec.MinLevel = 10

#
#    DualSpec.AutoUnlock
#        Description: Unlock Dual Talent Specialization for free, with no
#                     command, on login and on level-up for every character
#                     at or above DualSpec.MinLevel. With DualSpec.MinLevel 1
#                     every character has it from creation. Characters that
#                     already have it are left alone. Bots (headless
#                     sessions) are skipped.
#        Default:     0 - Disabled
#                     1 - Enabled
#

DualSpec.AutoUnlock = 0
